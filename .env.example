# Cloudflare Pages > Settings > Environment variables.
# CRM_WEBHOOK_URL must be marked "Secret" - it accepts lead data unauthenticated.

# Go High Level inbound webhook that receives each lead as JSON.
CRM_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/PLACEHOLDER

# Random string used to pepper IP hashes. Generate with: openssl rand -hex 32
IP_HASH_SALT=PLACEHOLDER_GENERATE_A_RANDOM_HEX_STRING
