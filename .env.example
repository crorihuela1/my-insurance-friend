# Cloudflare Pages > Settings > Environment variables.
# CRM_WEBHOOK_URL must be marked "Secret" - it accepts lead data unauthenticated.

# Go High Level inbound webhook that receives each lead as JSON.
CRM_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/PLACEHOLDER

# Random string used to pepper IP hashes. Generate with: openssl rand -hex 32
IP_HASH_SALT=PLACEHOLDER_GENERATE_A_RANDOM_HEX_STRING

# --- Social publishing (scripts/publish-social.mjs) -------------------------
# Only needed to actually post. The generator needs none of these.
# Meta: long-lived Page access token from a Meta Business app.
META_ACCESS_TOKEN=PLACEHOLDER
# Numeric Facebook Page id.
FB_PAGE_ID=PLACEHOLDER
# Instagram Business account id (must be linked to the Page above).
IG_USER_ID=PLACEHOLDER
# TikTok OAuth token. Direct publishing needs the AUDITED video.publish scope;
# without the audit, posts land in drafts only.
TIKTOK_ACCESS_TOKEN=PLACEHOLDER
