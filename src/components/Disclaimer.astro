---
import { disclaimerText } from '../lib/compliance';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/types';

/**
 * Required on every page, rendered in the page language. `variant="compact"` is
 * the footer rendering; "boxed" is used inline near conversion points.
 */
interface Props { lang: Lang; variant?: 'compact' | 'boxed' }
const { lang, variant = 'compact' } = Astro.props;
const text = disclaimerText(lang);
---

{
  variant === 'boxed' ? (
    <aside
      class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm leading-relaxed text-amber-950"
      role="note"
      data-disclaimer
    >
      <p class="mb-1 font-semibold">{t(lang, 'disclaimer_title')}</p>
      <p>{text}</p>
    </aside>
  ) : (
    <p class="text-xs leading-relaxed text-slate-400" data-disclaimer>
      <span class="font-semibold text-slate-300">{t(lang, 'disclaimer_title')}:</span> {text}
    </p>
  )
}
