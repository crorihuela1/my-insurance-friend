---
import { t } from '../lib/i18n';
import { telUrl, whatsappUrl } from '../lib/whatsapp';
import type { Lang } from '../lib/types';

/** Mobile-only sticky conversion bar. Pure CSS + anchors, zero JS. */
interface Props { lang: Lang; context: string; slug: string }
const { lang, context, slug } = Astro.props;
const wa = whatsappUrl({ lang, context, slug });
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px border-t border-slate-200 bg-slate-200 md:hidden"
  role="region"
  aria-label={t(lang, 'cta_sticky_aria')}
>
  <a
    href={wa}
    rel="noopener"
    target="_blank"
    class="flex min-h-16 items-center justify-center gap-2 bg-wa-500 px-2 text-sm font-semibold text-white"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-current">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.17c-.25.69-1.43 1.32-1.97 1.37-.53.05-1.02.24-3.44-.72-2.9-1.14-4.73-4.1-4.87-4.29-.14-.19-1.16-1.54-1.16-2.94s.73-2.09 1-2.38c.26-.29.57-.36.76-.36l.55.01c.18.01.41-.07.64.49.24.57.8 1.97.87 2.11.07.14.12.31.02.5-.09.19-.14.31-.28.48l-.42.49c-.14.14-.28.29-.12.57.16.29.72 1.18 1.54 1.92 1.06.94 1.95 1.23 2.23 1.37.28.14.44.12.6-.07.17-.19.69-.8.87-1.08.19-.29.38-.24.64-.14.25.09 1.62.76 1.9.9.28.14.46.21.53.33.07.12.07.69-.18 1.37z" />
    </svg>
    {lang === 'es' ? 'Cotización gratis' : 'Free quote'}
  </a>
  <a
    href={telUrl()}
    class="flex min-h-16 items-center justify-center gap-2 bg-brand-700 px-2 text-sm font-semibold text-white"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-current">
      <path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 013 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z" />
    </svg>
    {t(lang, 'cta_call_short')}
  </a>
</div>
