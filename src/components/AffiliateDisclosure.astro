---
import { affiliateDisclosure } from '../lib/compliance';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/types';

/**
 * FTC requirement: must appear in the page language ABOVE the first affiliate
 * link. Render this immediately before any block containing partner links.
 */
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<aside
  class="rounded-md border border-slate-200 bg-slate-50 p-3 text-xs leading-relaxed text-slate-600"
  data-affiliate-disclosure
>
  <span class="font-semibold text-slate-700">{t(lang, 'affiliate_title')}:</span>
  {affiliateDisclosure[lang]}
</aside>
