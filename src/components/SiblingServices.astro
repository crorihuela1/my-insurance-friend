---
import { services, townName } from '../lib/data';
import { t } from '../lib/i18n';
import { townServicePath } from '../lib/urls';
import type { Lang, Service, Town } from '../lib/types';

/** Other services, same town - the vertical half of the internal link graph. */
interface Props { lang: Lang; town: Town; current: Service }
const { lang, town, current } = Astro.props;
const siblings = services.filter((s) => s.slug_en !== current.slug_en);
const name = townName(town, lang);
---

<section class="mt-10" aria-labelledby="siblings-heading">
  <h2 id="siblings-heading" class="text-xl font-bold text-brand-900">
    {t(lang, 'h_other_services')} {name}
  </h2>
  <ul class="mt-3 grid gap-2 sm:grid-cols-3">
    {
      siblings.map((s) => (
        <li>
          <a
            href={townServicePath(s, town, lang)}
            class="flex h-full flex-col rounded-lg border border-slate-200 p-3.5 transition-colors hover:border-brand-600 hover:bg-brand-50"
          >
            <span class="font-semibold text-brand-800">
              {lang === 'es' ? s.name_es : s.name_en}
            </span>
            <span class="mt-0.5 text-xs text-slate-500">
              {lang === 'es' ? s.lines_label_es : s.lines_label_en}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
