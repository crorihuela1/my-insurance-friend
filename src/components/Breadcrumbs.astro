---
/** Visible breadcrumbs; BreadcrumbList JSON-LD is emitted by the page. */
interface Props { items: Array<{ name: string; path: string }> }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-xs text-slate-500">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true" class="text-slate-300">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-slate-600">{item.name}</span>
          ) : (
            <a href={item.path} class="hover:text-brand-700 hover:underline">{item.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
