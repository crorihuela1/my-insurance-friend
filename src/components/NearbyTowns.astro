---
import { nearbyTowns, townName } from '../lib/data';
import { t } from '../lib/i18n';
import { townServicePath } from '../lib/urls';
import type { Lang, Service, Town } from '../lib/types';

/** Same service, nearby towns - the lateral half of the internal link graph. */
interface Props { lang: Lang; town: Town; service: Service }
const { lang, town, service } = Astro.props;
const nearby = nearbyTowns(town);
const label = lang === 'es' ? service.name_es : service.name_en;
---

<section class="mt-10" aria-labelledby="nearby-heading">
  <h2 id="nearby-heading" class="text-xl font-bold text-brand-900">
    {t(lang, 'h_nearby')}
  </h2>
  <p class="mt-1 text-sm text-slate-600">
    {
      lang === 'es'
        ? `También atendemos ${label.toLowerCase()} en estas ciudades cercanas:`
        : `We also cover ${label.toLowerCase()} in these nearby cities:`
    }
  </p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {
      nearby.map((n) => (
        <li>
          <a
            href={townServicePath(service, n, lang)}
            class="inline-block rounded-full border border-slate-300 px-3.5 py-1.5 text-sm text-slate-700 hover:border-brand-600 hover:text-brand-700"
          >
            {label} {lang === 'es' ? 'en' : 'in'} {townName(n, lang)}
          </a>
        </li>
      ))
    }
  </ul>
</section>
