---
import { getFact } from '../lib/data';
import type { Lang } from '../lib/types';

/**
 * Renders one legal fact from src/data/legal_facts.json with its citation.
 * Copy never hardcodes these numbers - change the JSON and every page updates.
 *
 * Styling is deliberately quiet: a thin rule and muted citation rather than a
 * filled card, so a run of three or four facts reads as part of the paragraph
 * flow instead of stacking into a wall of boxes.
 */
interface Props { id: string; lang: Lang; showSource?: boolean }
const { id, lang, showSource = true } = Astro.props;
const fact = getFact(id);
---

<li class="border-l-2 border-slate-200 pl-4">
  <p class="text-[1.0625rem] leading-relaxed text-slate-800">
    {lang === 'es' ? fact.text_es : fact.text_en}
  </p>
  {
    showSource && (
      <p class="mt-1 text-xs text-slate-400">
        <a
          href={fact.source_url}
          rel="noopener nofollow"
          target="_blank"
          class="underline decoration-slate-300 underline-offset-2 hover:text-slate-600"
        >
          {fact.citation}
        </a>
      </p>
    )
  }
</li>
