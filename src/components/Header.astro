---
import { site } from '../lib/data';
import { t } from '../lib/i18n';
import { homePath, otherLang, stateHubPath } from '../lib/urls';
import { telUrl } from '../lib/whatsapp';
import type { Lang } from '../lib/types';

interface Props { lang: Lang; altPath: string }
const { lang, altPath } = Astro.props;
const alt = otherLang(lang);
// TODO: point at /es/guias once the pillar guides ship. Until then this links
// to the about page rather than a 404.
const guides = lang === 'es' ? '/es/quienes-somos' : '/en/about';
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3">
    <a href={homePath(lang)} class="text-base font-bold text-brand-900 sm:text-lg">
      {site.brand.name}
    </a>

    <nav class="flex items-center gap-3 text-sm" aria-label={t(lang, 'nav_services')}>
      <a href={stateHubPath(lang)} class="hidden text-slate-600 hover:text-brand-700 sm:inline">
        {t(lang, 'nav_services')}
      </a>
      <a href={guides} class="hidden text-slate-600 hover:text-brand-700 sm:inline">
        {t(lang, 'nav_about')}
      </a>
      <a
        href={telUrl()}
        class="hidden font-semibold text-brand-700 hover:underline sm:inline"
      >
        {site.contact.phone_display}
      </a>
      <a
        href={altPath}
        hreflang={alt}
        aria-label={t(lang, 'lang_switch_aria')}
        class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-brand-600 hover:text-brand-700"
      >
        {t(lang, 'lang_switch')}
      </a>
    </nav>
  </div>
</header>
