---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import NearbyTowns from '../components/NearbyTowns.astro';
import SiblingServices from '../components/SiblingServices.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { countyName, serviceName, townName } from '../lib/data';
import { t } from '../lib/i18n';
import { absolute, homePath, townHubPath, townServicePath } from '../lib/urls';
import { breadcrumbs, faqPage, serviceSchema } from '../lib/schema';
import {
  ogImagePath,
  townServiceDescription,
  townServiceH1,
  townServiceTitle,
} from '../lib/seo';
import type { Lang, Service, Town } from '../lib/types';

/**
 * The single template for all 96 town x service pages. Hand-written reference
 * MDX and generator output both render through here, so a change to the layout
 * lands on every page at once.
 */
interface Props {
  town: Town;
  service: Service;
  lang: Lang;
  lede: string;
  updated: Date;
  title?: string;
  description?: string;
  h1?: string;
}

const { town, service, lang, lede, updated, title, description, h1 } = Astro.props;

const path = townServicePath(service, town, lang);
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altPath = townServicePath(service, town, altLang);
const pageUrl = absolute(path);

const name = townName(town, lang);
const svcName = serviceName(service, lang);
const county = countyName(town, lang);

const pageTitle = title ?? townServiceTitle(service, town, lang);
const pageDesc = description ?? townServiceDescription(service, town, lang);
const pageH1 = h1 ?? townServiceH1(service, town, lang);

const ctaContext =
  lang === 'es' ? `${svcName.toLowerCase()} en ${name}` : `${svcName.toLowerCase()} in ${name}`;

const crumbs = [
  { name: t(lang, 'breadcrumb_home'), path: homePath(lang) },
  { name: name, path: townHubPath(town, lang) },
  { name: svcName, path },
];

const schema = [
  breadcrumbs(crumbs),
  faqPage(service.faq, lang, pageUrl),
  serviceSchema(service, town, lang),
];

const updatedLabel = updated.toLocaleDateString(lang === 'es' ? 'es-US' : 'en-US', {
  year: 'numeric',
  month: 'long',
});

const zips = town.zip_list.slice(0, 6).join(', ');
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={pageDesc}
  path={path}
  altPath={altPath}
  schema={schema}
  ogImage={ogImagePath(path)}
  ctaContext={ctaContext}
>
  <article class="mx-auto max-w-3xl px-4 py-6" data-page-type="town-service">
    <Breadcrumbs items={crumbs} />

    <h1 class="mt-3 text-3xl font-extrabold leading-tight text-brand-900 sm:text-4xl">
      {pageH1}
    </h1>

    <p class="mt-3 text-lg leading-relaxed text-slate-700">{lede}</p>

    <p class="mt-2 text-xs text-slate-500">
      {county} · {lang === 'es' ? 'Códigos postales' : 'ZIP codes'} {zips} ·
      {t(lang, 'last_updated')} {updatedLabel}
    </p>

    {/* CTA above the fold - required on every town x service page. */}
    <div class="mt-5">
      <WhatsAppCta lang={lang} context={ctaContext} slug={path} />
      <p class="mt-2 text-center text-xs text-slate-500 sm:text-left">
        {t(lang, 'response_promise')}
      </p>
    </div>

    {/* Body copy: MDX from the content collection. */}
    <div class="prose-body mt-8 text-[1.0625rem] text-slate-800">
      <slot />
    </div>

    <Faq lang={lang} faq={service.faq} />

    <section class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-6">
      <LeadForm
        lang={lang}
        slug={path}
        defaultCity={name}
        heading={t(lang, 'h_form')}
      />
    </section>

    {/* CTA at the bottom - the second required conversion point. */}
    <div class="mt-8">
      <WhatsAppCta lang={lang} context={ctaContext} slug={path} />
    </div>

    <SiblingServices lang={lang} town={town} current={service} />
    <NearbyTowns lang={lang} town={town} service={service} />
  </article>
</BaseLayout>
