---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { t } from '../lib/i18n';
import { absolute } from '../lib/urls';
import { breadcrumbs } from '../lib/schema';
import type { Lang } from '../lib/types';

export interface LinkGroup {
  /** Optional group heading, e.g. a county name. */
  heading?: string;
  links: Array<{ label: string; sub?: string; href: string }>;
}

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  altPath: string;
  h1: string;
  lede: string;
  crumbs: Array<{ name: string; path: string }>;
  groups: LinkGroup[];
  ctaContext: string;
  formCity?: string;
  schema?: object[];
}

const {
  lang, title, description, path, altPath, h1, lede, crumbs, groups, ctaContext, formCity, schema = [],
} = Astro.props;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  altPath={altPath}
  ctaContext={ctaContext}
  schema={[breadcrumbs(crumbs), ...schema]}
>
  <div class="mx-auto max-w-3xl px-4 py-6" data-page-type="hub">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-3 text-3xl font-extrabold leading-tight text-brand-900 sm:text-4xl">{h1}</h1>
    <p class="mt-3 text-lg leading-relaxed text-slate-700">{lede}</p>

    <div class="mt-5">
      <WhatsAppCta lang={lang} context={ctaContext} slug={path} />
    </div>

    {
      /* Intro prose, when the page has any. */
      Astro.slots.has('default') && (
        <div class="prose-body mt-8 text-[1.0625rem] text-slate-800">
          <slot />
        </div>
      )
    }

    {
      groups.map((group) => (
        <section class="mt-9">
          {group.heading && (
            <h2 class="mb-3 text-xl font-bold text-brand-900">{group.heading}</h2>
          )}
          <ul class="grid gap-2.5 sm:grid-cols-2">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex h-full flex-col rounded-lg border border-slate-200 p-3.5 transition-colors hover:border-brand-600 hover:bg-brand-50"
                >
                  <span class="font-semibold text-brand-800">{link.label}</span>
                  {link.sub && <span class="mt-0.5 text-xs text-slate-500">{link.sub}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-6">
      <LeadForm lang={lang} slug={path} defaultCity={formCity ?? ''} heading={t(lang, 'h_form')} />
    </section>

    <div class="mt-8">
      <WhatsAppCta lang={lang} context={ctaContext} slug={path} />
    </div>
  </div>
</BaseLayout>
