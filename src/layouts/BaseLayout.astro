---
import '../styles/global.css';
import { site } from '../lib/data';
import { absolute, otherLang } from '../lib/urls';
import { graph, localBusiness } from '../lib/schema';
import { ogImagePath } from '../lib/seo';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/types';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page. Its translated twin is derived for hreflang. */
  path: string;
  altPath: string;
  /** schema.org nodes to merge into the page @graph. */
  schema?: object[];
  ogImage?: string;
  /** Sticky CTA context, e.g. "seguro para contratistas en Paterson". */
  ctaContext?: string;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  altPath,
  schema = [],
  ogImage,
  ctaContext,
  noindex = false,
} = Astro.props;

const canonical = absolute(path);
const alt = otherLang(lang);
const htmlLang = lang === 'es' ? 'es-US' : 'en-US';
// Every page has a generated OG image at a path mirroring its own.
const og = ogImage ?? ogImagePath(path);

// Spanish is the primary language, so x-default points at /es.
const esPath = lang === 'es' ? path : altPath;

const jsonLd = graph([localBusiness(lang), ...schema]);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang={lang === 'es' ? 'es' : 'en'} href={absolute(path)} />
    <link rel="alternate" hreflang={alt === 'es' ? 'es' : 'en'} href={absolute(altPath)} />
    <link rel="alternate" hreflang="x-default" href={absolute(esPath)} />

    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(og)} />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />
    <meta property="og:site_name" content={site.brand.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>

  <body class="bg-white text-slate-800 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-white"
    >
      {t(lang, 'skip_to_content')}
    </a>

    <Header lang={lang} altPath={altPath} />

    <main id="contenido">
      <slot />
    </main>

    <Footer lang={lang} />

    {ctaContext && <StickyBar lang={lang} context={ctaContext} slug={path} />}
  </body>
</html>
