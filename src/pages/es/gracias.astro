---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import { site } from '../../lib/data';
import { t } from '../../lib/i18n';

const lang = 'es' as const;
const path = '/es/gracias';
---

<BaseLayout
  lang={lang}
  title="Gracias — te contactamos en minutos"
  description="Recibimos tu solicitud. Un agente con licencia te contacta en menos de 5 minutos en horario laboral."
  path={path}
  altPath="/en/thank-you"
  noindex={true}
>
  <div class="mx-auto max-w-xl px-4 py-10 text-center">
    <div
      class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-wa-500/15"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" class="h-8 w-8 fill-wa-600">
        <path d="M9.6 16.6 5 12l1.4-1.4 3.2 3.2 8-8L19 7.2z" />
      </svg>
    </div>

    <h1 class="mt-5 text-3xl font-extrabold text-brand-900">¡Listo! Ya tenemos tu solicitud</h1>

    <p class="mt-3 text-lg leading-relaxed text-slate-700">
      {t(lang, 'response_promise')}
    </p>

    <p class="mt-2 text-sm text-slate-500">{site.contact.hours_es}</p>

    <div class="mt-7 rounded-xl border border-slate-200 bg-slate-50 p-5 text-left">
      <h2 class="text-base font-bold text-brand-900">Qué sigue</h2>
      <ol class="prose-body mt-2 text-[0.9375rem] text-slate-700">
        <li>Un agente de seguros <strong>con licencia</strong> revisa tu caso.</li>
        <li>Te llama o te escribe al número que nos diste, en español.</li>
        <li>Te explica tus opciones. Tú decides, sin compromiso.</li>
      </ol>
      <p class="mt-3 text-sm text-slate-600">
        Recuerda: nosotros no vendemos pólizas. Te conectamos con quien sí tiene licencia para
        hacerlo, y no te cobramos nada por eso.
      </p>
    </div>

    <div class="mt-7 text-left">
      <p class="mb-2 text-center text-sm font-semibold text-slate-700">
        ¿Es urgente? Escríbenos directo:
      </p>
      <WhatsAppCta lang={lang} context="tu solicitud" slug={path} />
    </div>

    <p class="mt-6 text-sm text-slate-600">
      ¿Prefieres agendar una hora?
      <a class="font-semibold text-brand-700 underline" href={site.contact.calendar_url}>
        Elige un horario aquí
      </a>.
    </p>
  </div>
</BaseLayout>
